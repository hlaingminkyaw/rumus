{
  "name": "your-vendor/composer-rumus",
  "description": "Reusable Laravel invoice and invoice-cash reports for existing POS applications.",
  "keywords": ["laravel", "reports", "invoice", "cash", "pos"],
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0"
  },
  "autoload": {
    "psr-4": {
      "ComposerRumus\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ComposerRumus\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ComposerRumus\\ComposerRumusServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
