{
  "name": "kyawgyi/rumus",
  "description": "Reusable Laravel invoice and invoice-cash reports for existing POS applications.",
  "keywords": ["laravel", "reports", "invoice", "cash", "pos"],
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "ComposerRumus\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ComposerRumus\\ComposerRumusServiceProvider"
      ]
    }
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
